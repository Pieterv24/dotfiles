hl.on("hyprland.start", function()
{{- if .waybar.enabled }}
  hl.exec_cmd("~/.config/hypr/scripts/waybar.sh")
{{- end }}

{{- if .noctalia.enabled }}
  {{- if .noctalia.beta }}
  hl.exec_cmd("noctalia")
  {{- else }}
  hl.exec_cmd("qs -c noctalia-shell")
  {{- end }}
{{- else if and .quickshell.enabled (not .noctalia.enabled) }}
  hl.exec_cmd("qs -c quickway")
{{- end }}

  -- hl.exec_cmd("noctalia")
  hl.exec_cmd("hyprpm reload -n")
  hl.exec_cmd("~/.config/hypr/scripts/xdg.sh")
  hl.exec_cmd("systemctl --user start hyprpolkitagent.service")
  hl.exec_cmd("wl-clip-persist --clipboard regular")

{{- if not .noctalia.enabled }}
  hl.exec_cmd("systemctl --user start hypridle.service")
  hl.exec_cmd("systemctl start --user dunst.service")
  hl.exec_cmd("avizo-service")
  hl.exec_cmd("systemctl start --user hyprpaper.service")
{{- end }}

  hl.exec_cmd('element-desktop --password-store="gnome-libsecret"', { workspace = "11 silent" })
  hl.exec_cmd("discord", { workspace = "11 silent" })

  hl.dispatch(hl.dsp.focus({ workspace = 1 }))
end)
